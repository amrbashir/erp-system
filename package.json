{
	"name": "erp-system",
	"private": true,
	"scripts": {
		"dev:web": "pnpm --filter @workspace/web dev",
		"dev:desktop": "pnpm --filter @workspace/desktop dev",
		"build:web": "pnpm --filter @workspace/web build",
		"build:desktop": "pnpm --filter @workspace/desktop build",
		"test": "vitest run",
		"typecheck": "pnpm -r typecheck",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.13.2",
		"oxfmt": "^0.36.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	}
}
