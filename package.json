{
	"name": "erp-system",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @workspace/web dev",
		"dev:desktop": "pnpm --filter @workspace/desktop dev",
		"build:web": "pnpm --filter @workspace/web build",
		"build:desktop": "pnpm --filter @workspace/desktop build",
		"build:desktop:sidecar": "pnpm --filter @workspace/desktop build:sidecar",
		"dev:admin": "pnpm --filter @workspace/admin dev",
		"typecheck": "pnpm -r typecheck",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"ralph": "pnpm exec ralph"
	},
	"devDependencies": {
		"@workspace/ralph": "workspace:*",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.62.0",
		"oxlint-tsgolint": "^0.22.1",
		"typescript": "catalog:",
		"vite-tsconfig-paths": "catalog:vite"
	}
}
