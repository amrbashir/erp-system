{
	"name": "erp-system",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @workspace/web dev",
		"dev:desktop": "pnpm --filter @workspace/desktop dev",
		"build:web": "pnpm --filter @workspace/web build",
		"build:desktop": "pnpm --filter @workspace/desktop build",
		"dev:admin": "pnpm --filter @workspace/admin dev",
		"build:server:desktop": "pnpm --filter @workspace/desktop build:sidecar",
		"test": "vitest run",
		"typecheck": "pnpm -r typecheck",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"ralph": "pnpm exec ralph"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.13.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@workspace/ralph": "workspace:*",
		"happy-dom": "^20.8.9",
		"oxfmt": "^0.36.0",
		"typescript": "^5.6.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^2.1.0"
	}
}
