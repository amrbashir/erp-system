{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Kaname ERP",
	"version": "0.1.0",
	"identifier": "me.amrbashir.kaname-erp",
	"build": {
		"frontendDist": "../../web/dist/client",
		"devUrl": "http://localhost:1522",
		"beforeDevCommand": "pnpm --filter @workspace/desktop run --parallel /dev:/"
	},
	"app": {
		"windows": [
			{
				"title": "Kaname ERP"
			}
		]
	},
	"plugins": {
		"updater": {
			"endpoints": [],
			"pubkey": ""
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "dmg", "rpm", "deb", "appimage"],
		"externalBin": ["binaries/kaname-erp-sidecar"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
