{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"#db": ["./adapters/pglite.ts"],
			"#auth": ["./lib/desktop-auth.ts"]
		}
	},
	"include": ["."],
	"exclude": [
		"node_modules",
		"dist",
		".output",
		"routes",
		"plugins",
		"build-desktop.ts",
		"nitro.desktop.config.ts"
	]
}
