{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"paths": {
			// Important for shadcn to resolve correctly
			"@workspace/ui/*": ["./src/*"]
		}
	}
}
