{
	"name": "@workspace/i18n",
	"version": "0.0.0",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./paraglide/messages": "./src/paraglide/messages.js",
		"./paraglide/runtime": "./src/paraglide/runtime.js",
		"./paraglide/server": "./src/paraglide/server.js"
	},
	"scripts": {
		"compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "catalog:",
		"typescript": "catalog:"
	}
}
